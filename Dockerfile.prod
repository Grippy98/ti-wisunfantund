# Stage 1: Builder
FROM ubuntu:22.04 AS builder

# Install build dependencies
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y \
    build-essential \
    autoconf \
    autoconf-archive \
    libtool \
    pkg-config \
    libdbus-1-dev \
    libboost-dev \
    libreadline-dev \
    libcoap2-bin \
    git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy source code
COPY . .

# Build wfantund
RUN ./bootstrap.sh && \
    ./configure --sysconfdir=/etc --prefix=/usr && \
    make -j$(nproc) && \
    make install DESTDIR=/tmp/install

# Stage 2: Runtime
FROM ubuntu:22.04

# Install runtime dependencies
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y \
    libdbus-1-3 \
    libreadline8 \
    libcoap2 \
    net-tools \
    iproute2 \
    && rm -rf /var/lib/apt/lists/*

# Copy installed files from builder
COPY --from=builder /tmp/install /

# Create necessary directories if they don't exist (though make install should have handled it)
RUN mkdir -p /etc/wpantund

# Set the entrypoint
ENTRYPOINT ["/usr/sbin/wfantund"]
CMD ["-h"]
