#!/usr/bin/make -f

%:
	dh $@ --buildsystem=cmake

override_dh_auto_configure:
	dh_auto_configure -- -G Ninja

override_dh_auto_install:
	dh_auto_install
	mkdir -p debian/wisun-rcp-host/usr/bin
	mkdir -p debian/wisun-rcp-host/etc
	cp bin/wisun-rcp-host debian/wisun-rcp-host/usr/bin/
	cp apps/border_router_nanostack_tirf/border_router_host.cfg debian/wisun-rcp-host/etc/wisun-rcp-host.cfg
